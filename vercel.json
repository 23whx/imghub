{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "trailingSlash": true,
  "redirects": [
    { "source": "/", "destination": "/en/", "permanent": true },
    { "source": "/about", "destination": "/en/about/", "permanent": true },
    { "source": "/about/", "destination": "/en/about/", "permanent": true },
    { "source": "/privacy", "destination": "/en/privacy/", "permanent": true },
    { "source": "/privacy/", "destination": "/en/privacy/", "permanent": true },
    { "source": "/terms", "destination": "/en/terms/", "permanent": true },
    { "source": "/terms/", "destination": "/en/terms/", "permanent": true },
    { "source": "/tools/:tool", "destination": "/en/tools/:tool/", "permanent": true },
    { "source": "/tools/:tool/", "destination": "/en/tools/:tool/", "permanent": true }
  ],
  "headers": [
    { "source": "/_astro/:path*", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/:path*", "has": [{ "type": "host", "value": ".*\\.vercel\\.app" }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
