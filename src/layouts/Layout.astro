---
import '../styles/global.css';
import '../styles/gallery.css';
import '../styles/fonts.css';
import CookieConsent from '../components/CookieConsent.jsx';
import { defaultLocale, htmlLang, ogLocale, isValidLocale } from '../i18n/config.js';
import { siteConfig, absoluteUrl } from '../config/site.js';
import { buildPageSchema, canonicalPath, serializeJsonLd } from '../utils/seo.js';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageAlt?: string;
  type?: string;
  lang?: string;
  pathWithoutLang?: string;
  alternates?: Array<{ lang: string; hreflang: string; href: string }>;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  indexable?: boolean;
  // false for pages without a real URL of their own (the 404 page)
  canonical?: boolean;
}

const {
  title,
  description = 'ImgHub - Free online image tools collection',
  keywords = 'image tools,online tools,ImgHub',
  image = siteConfig.image,
  imageAlt: pageImageAlt,
  type = 'website',
  lang = defaultLocale,
  pathWithoutLang = '',
  alternates = [],
  jsonLd = null,
  indexable = true,
  canonical = true,
} = Astro.props;

const locale = isValidLocale(lang) ? lang : defaultLocale;
const pageHtmlLang = htmlLang[locale as keyof typeof htmlLang] || 'en';
const pageOgLocale = ogLocale[locale as keyof typeof ogLocale] || 'en_US';
const alternateOgLocales = Object.entries(ogLocale)
  .filter(([code]) => code !== locale)
  .map(([, value]) => value);

const canonicalURL = canonicalPath(locale, pathWithoutLang);
const ogImage = absoluteUrl(image);
const structuredData = buildPageSchema({ lang: locale, title, description, path: pathWithoutLang, image: ogImage, extra: jsonLd });
const imageAlt = pageImageAlt || (locale === 'zh' ? 'ImgHub 免费在线图片工具集' : locale === 'ja' ? 'ImgHub 無料オンライン画像ツール集' : 'ImgHub free online image toolkit');
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
---

<!DOCTYPE html>
<html lang={pageHtmlLang} data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=5"
    />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Rollkey" />
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    <meta name="robots" content={indexable ? 'index, follow, max-image-preview:large' : 'noindex, follow'} />
    {canonical && <link rel="canonical" href={canonicalURL} />}
    {pathWithoutLang === '' && <link rel="preload" as="image" href="/assets/studio/gallery-hero-alps.webp" media="(min-width: 701px)" />}
    {pathWithoutLang === '' && <link rel="preload" as="image" href="/assets/studio/gallery-hero-alps-mobile.webp" media="(max-width: 700px)" />}

    <!-- hreflang alternates -->
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta name="theme-color" content="#14120f" />

    <!-- Restore the visitor's theme before paint. New visitors see the ivory gallery. -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('isDarkMode');
          if (saved !== null && JSON.parse(saved)) {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content={image.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:site_name" content="ImgHub" />
    <meta property="og:locale" content={pageOgLocale} />
    {alternateOgLocales.map((loc) => (
      <meta property="og:locale:alternate" content={loc} />
    ))}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <meta name="twitter:url" content={canonicalURL} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:creator" content={siteConfig.socialHandle} />

    <!-- Fonts are bundled locally in fonts.css. -->

    <!-- Structured Data (JSON-LD) -->
    <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />

    <!-- Google AdSense -->
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4880646654838411"
      crossorigin="anonymous"></script>
  </head>
  <body class="font-sans antialiased studio-site">
    <slot />
    <CookieConsent client:load lang={locale} />
  </body>
</html>
