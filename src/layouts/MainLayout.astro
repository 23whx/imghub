---
import Layout from './Layout.astro';
import Navbar from '../components/Navbar.jsx';
import { defaultLocale, isValidLocale } from '../i18n/config.js';
import { buildAlternates, localizedPath } from '../i18n/utils.js';
import { getUi } from '../i18n/ui.js';
import { getStudioCopy } from '../i18n/studio.js';
import { siteConfig } from '../config/site.js';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
  lang?: string;
  pathWithoutLang?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[] | null;
  indexable?: boolean;
  canonical?: boolean;
}
const { title, description, keywords, lang = defaultLocale, pathWithoutLang = '', jsonLd = null, indexable = true, canonical = true } = Astro.props;
const locale = isValidLocale(lang) ? lang : defaultLocale;
const alternates = indexable ? buildAlternates(siteConfig.url, pathWithoutLang) : [];
const t = getUi(locale);
const studio = getStudioCopy(locale);
const isHome = pathWithoutLang === '';
---
<Layout title={title} description={description} keywords={keywords} lang={locale} pathWithoutLang={pathWithoutLang} alternates={alternates} jsonLd={jsonLd} indexable={indexable} canonical={canonical}>
  <a class="skip-link" href="#main-content">{locale === 'zh' ? '跳到主要内容' : locale === 'ja' ? '本文へ移動' : 'Skip to content'}</a>
  <Navbar client:load lang={locale} isHome={isHome} />
  <main id="main-content" class:list={['studio-main', { 'studio-main-home': isHome }]}>
    <slot />
  </main>
  <footer class="studio-footer">
    <div class="studio-container">
      <div class="footer-top"><a href={localizedPath(locale)} class="footer-wordmark">ImgHub</a><div><p>{studio.footer}</p><a href={localizedPath(locale) + '#tools'} class="text-link">{studio.browse}<span aria-hidden="true">↗</span></a></div></div>
      <div class="footer-bottom"><p>© {new Date().getFullYear()} ImgHub · Rollkey</p><nav aria-label="Footer"><a href={localizedPath(locale, 'about')}>{t.about}</a><a href={localizedPath(locale, 'privacy')}>{t.privacy}</a><a href={localizedPath(locale, 'terms')}>{t.terms}</a><a href="mailto:wyh93829@gmail.com">{t.contact}</a></nav></div>
    </div>
  </footer>
</Layout>
