---
// Not-found page (served by the host for unknown URLs). It is noindex and
// links every language's home page and public tools so a broken link still
// leads somewhere useful for visitors and crawlers.
import MainLayout from '../layouts/MainLayout.astro';
import { locales } from '../i18n/config.js';
import { publicTools } from '../i18n/tools.js';
import { localizedPath } from '../i18n/utils.js';

const copy: Record<string, { heading: string; home: string }> = {
  zh: { heading: '页面不存在', home: '返回中文首页' },
  en: { heading: 'Page not found', home: 'English home page' },
  ja: { heading: 'ページが見つかりません', home: '日本語のトップページ' },
};
const sections = locales.map(lang => ({
  lang,
  ...copy[lang],
  homeHref: localizedPath(lang),
  tools: publicTools.map(tool => ({
    href: localizedPath(lang, `tools/${tool.slug}`),
    title: ((tool.card as Record<string, { title: string }>)[lang] || tool.card.en).title,
  })),
}));
---
<MainLayout title="404 · Page not found | ImgHub" description="The page you requested does not exist." lang="en" pathWithoutLang="404" indexable={false} canonical={false}>
  <div class="reading-page">
    <h1>404 · Page not found</h1>
    <p>页面不存在，可能已经移动或删除。The page may have moved or been removed. ページが移動または削除された可能性があります。</p>
    {sections.map(section => (
      <section class="about-section" lang={section.lang}>
        <h2>{section.heading}</h2>
        <p><a class="text-link" href={section.homeHref}>{section.home}</a></p>
        <ul class="not-found-tools">
          {section.tools.map(tool => <li><a href={tool.href}>{tool.title}</a></li>)}
        </ul>
      </section>
    ))}
  </div>
</MainLayout>

<style>
  .not-found-tools { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 12px; }
  .not-found-tools a { text-decoration: underline; text-underline-offset: 4px; }
</style>
